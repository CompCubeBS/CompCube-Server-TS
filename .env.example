# PostgreSQL
PGCONNECTSTRING=postgres://compcube:compcube@localhost:5432/compcube
POSTGRES_DB=compcube
POSTGRES_USER=compcube
POSTGRES_PASSWORD=compcube

# BeatKhana OAuth
BK_CLIENT_ID=
BK_CLIENT_SECRET=
BK_API_URL=https://api.beatkhana.com/api
BK_AUTHORIZE_URL=https://api.beatkhana.com/api/oauth/authorize
BK_CALLBACK_URL=http://localhost:7198/oauth/callback
BK_LINKING_URL=https://beatkhana.com/users/@me/settings#linking
BK_PUBLIC_KEY_URL=https://api.beatkhana.com/api/requestPublicSignature

# Public URLs
PUBLIC_API_URL=http://localhost:7198
WEBSITE_URL=http://localhost:5173
CORS_ORIGIN=*
# Use .compcube.net in production so OAuth cookies work on both the API and website subdomains.
AUTH_COOKIE_DOMAIN=
BEATLEADER_API_URL=https://api.beatleader.xyz
SCORESABER_API_URL=https://scoresaber.com/api
BEATSAVER_API_URL=https://api.beatsaver.com
BEATSAVER_FALLBACK_API_URL=https://beatsaver.com/api
# A blank list accepts development builds. Production should list every supported plugin version explicitly.
PLUGIN_VERSIONS=

# Discord bot. Leave these empty to disable the bot.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

REST_PORT=7198
WS_PORT=8008
TIMER_POLL_MS=1000
TIMER_LEASE_MS=30000
DISCARD_SECONDS=60
PICK_SECONDS=45
TRUST_PROXY=loopback, linklocal, uniquelocal
